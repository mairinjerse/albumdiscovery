# Server-side only — never exposed to the client.

# console.anthropic.com
ANTHROPIC_API_KEY=

# https://www.last.fm/api/account/create — free, no user auth needed
LASTFM_API_KEY=

# Optional: override the Claude model used for recommendations.
# ANTHROPIC_MODEL=claude-sonnet-5

# Supabase project settings > API. The anon key is safe to expose to the
# browser — access is enforced by row-level security, not by keeping it secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
